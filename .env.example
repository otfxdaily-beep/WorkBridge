# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/workbridge?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Base URL of the app, used to build links in emails (verification, password reset, etc.)
APP_URL="http://localhost:3000"
