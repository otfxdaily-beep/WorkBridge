# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/workbridge?schema=public"

# Base URL of the app, used to build links in emails (verification, password reset, etc.)
APP_URL="http://localhost:3000"

# Optional, production only. Leave unset for local dev - file uploads (CVs,
# photos, verification documents) fall back to local disk under public/uploads/
# automatically when this isn't set. In production (e.g. on Vercel), connect a
# Vercel Blob store to the project and it sets this for you.
# BLOB_READ_WRITE_TOKEN=""
